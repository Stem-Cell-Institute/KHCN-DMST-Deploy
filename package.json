{
  "name": "sci-ace",
  "version": "2.0.0",
  "description": "Hệ thống Quản lý KHCN & ĐMST - Viện Tế bào gốc (SCI-ACE)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "dev": "node server.js",
    "build": "npm run build:css && npm run build:workflow-ui && npm run build:crd",
    "build:workflow-ui": "npm --prefix frontend/document-workflow-ui install && npm --prefix frontend/document-workflow-ui run build",
    "build:crd": "esbuild crd-lab-booking/main.jsx --bundle --outfile=crd-lab-booking/bundle.js --format=iife --loader:.jsx=jsx --jsx=automatic --platform=browser",
    "migrate:turso": "node scripts/migrate-to-turso.js",
    "db:status": "node scripts/db-status.js",
    "routes:inventory": "node scripts/route-inventory.js",
    "import:sjr": "node scripts/import-sjr-csv.js",
    "migrate:reset-precreated": "node migrations/reset-precreated-passwords.js",
    "orcid:harvest": "node scripts/orcid-harvest-cli.js",
    "build:css": "tailwindcss -c scripts/tailwind.config.js -i scripts/tailwind.input.css -o public/css/tailwind.css --minify"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "tailwindcss": "^3.4.17"
  },
  "keywords": [
    "khcn",
    "dmst",
    "sci-ace",
    "turso",
    "sqlite"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=24.22.1 <25.0.0"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "archiver": "^6.0.1",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.11.1",
    "bibtex-parse": "^2.1.0",
    "chart.js": "4.4.1",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "csv-parse": "^6.2.1",
    "docx": "^9.6.1",
    "docxtemplater": "^3.68.3",
    "dotenv": "^16.6.1",
    "ejs": "^5.0.1",
    "exceljs": "^4.4.0",
    "express": "^4.22.1",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide": "^0.577.0",
    "lucide-react": "^0.577.0",
    "multer": "^2.5.0",
    "nodemailer": "^6.9.7",
    "pdfkit": "0.20.2",
    "pizzip": "^3.2.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sortablejs": "^1.15.2",
    "xlsx": "^0.18.5"
  }
}
